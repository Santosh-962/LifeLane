<?xml version="1.0" encoding="UTF-8"?>
<!-- LifeLane – 4-way junction edges (2 lanes per arm, 50 km/h = 13.89 m/s) -->
<edges>
    <!-- Inbound edges to central junction C -->
    <edge id="N2C" from="N" to="C" priority="2" numLanes="2" speed="13.89"/>
    <edge id="S2C" from="S" to="C" priority="2" numLanes="2" speed="13.89"/>
    <edge id="E2C" from="E" to="C" priority="1" numLanes="2" speed="13.89"/>
    <edge id="W2C" from="W" to="C" priority="1" numLanes="2" speed="13.89"/>

    <!-- Outbound edges from central junction C -->
    <edge id="C2N" from="C" to="N" priority="2" numLanes="2" speed="13.89"/>
    <edge id="C2S" from="C" to="S" priority="2" numLanes="2" speed="13.89"/>
    <edge id="C2E" from="C" to="E" priority="1" numLanes="2" speed="13.89"/>
    <edge id="C2W" from="C" to="W" priority="1" numLanes="2" speed="13.89"/>
</edges>
